{
  "name": "graph-excel-mcp",
  "version": "0.4.0",
  "description": "MCP server for reading and editing Excel workbooks on SharePoint/OneDrive via Microsoft Graph: base-checked writes, read-back verification, fills. Zero dependencies.",
  "license": "MIT",
  "author": "mickey-ichi",
  "homepage": "https://github.com/mickey-ichi/graph-excel-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mickey-ichi/graph-excel-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mickey-ichi/graph-excel-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "excel",
    "sharepoint",
    "onedrive",
    "microsoft-graph",
    "claude"
  ],
  "type": "module",
  "bin": {
    "graph-excel-mcp": "dist/cli.js"
  },
  "exports": {
    "./excel": "./dist/excel.js",
    "./graph": "./dist/graph.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "workbooks.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "pack": "npm run build && node scripts/pack.ts",
    "prepack": "npm run build",
    "login": "node src/cli.ts login",
    "mcp": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2"
  }
}
